{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Group the pinned CPython version and python-build-standalone release into one PR",
      "matchPackageNames": [
        "python",
        "astral-sh/python-build-standalone"
      ],
      "groupName": "python",
      "groupSlug": "python"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Python minor in the tests (version output, /opt/python/lib/python3.X paths) in sync with the pinned PYTHON_VERSION",
      "managerFilePatterns": [
        "/^test/python_(command_)?test\\.yml$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "versioningTemplate": "docker",
      "matchStrings": [
        "[Pp]ython ?(?<currentValue>3\\.\\d+)['/]"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the Python version in the README features list in sync with the pinned PYTHON_VERSION",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "versioningTemplate": "docker",
      "matchStrings": [
        "\\*\\*Python (?<currentValue>3\\.\\d+\\.\\d+)\\*\\*"
      ]
    }
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "assignees": [
    "ragedunicorn"
  ]
}
